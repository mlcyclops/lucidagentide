  "classes": ["public", "internal", "confidential", "cui"],
  "kinds": ["audit", "console_audit", "log", "span"],
  "severity": {
    "from_cef": [
      {"cef": [0, 3], "otel": 9},
      {"cef": [4, 6], "otel": 13},
      {"cef": [7, 7], "otel": 17},
      {"cef": [8, 8], "otel": 18},
      {"cef": [9, 10], "otel": 21}
    ],
    "outcomes": {"debug": 5},
    "default": 9
  },
  "resource_attributes": [
    {"name": "service.name", "required": true, "values": ["lucid-console", "lucid-relay"], "tag": "plain"},
    {"name": "service.version", "required": true, "meaning": "The build version of the console or relay.", "tag": "plain"},
    {"name": "service.instance.id", "required": true, "meaning": "The relay id or the console id.", "tag": "plain"},
    {"name": "lucid.org", "required": true, "meaning": "The org whose destination receives the batch.", "tag": "plain"},
    {"name": "lucid.relay.id", "required": false, "meaning": "The relay the records come from; absent for the console's own records.", "tag": "plain"},
    {"name": "lucid.region", "required": false, "meaning": "The relay's region as the registry holds it.", "tag": "plain"},
    {"name": "deployment.environment", "required": false, "meaning": "Set by an admin on the destination.", "tag": "plain"}
