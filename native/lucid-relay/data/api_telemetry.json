  "families": [
    {"prom": "lucid_console_info", "otel": "lucid.console.info", "type": "gauge", "otel_type": "gauge", "monotonic": false, "unit": "1", "help": "Version, security profile and FIPS mode of this Lucid Admin Console.", "labels": {"version": "plain", "profile": "plain", "fips": "plain"}, "class": "internal"},
