    {"prom": "lucid_relay_last_contact_seconds", "otel": "lucid.relay.last.contact", "type": "gauge", "otel_type": "gauge", "monotonic": false, "unit": "s", "help": "Seconds since the relay was last in touch.", "labels": {"relay": "plain", "name": "plain", "site": "plain", "product": "plain"}, "class": "internal"},
