{
 "version": 1,
 "contract": "AC-2a revision 3.4",
 "about": "4.11 and 5.4 (revision 3, A2-H2): under read-health alone the relay builds each answer field by field from this list and nothing else may appear; paths are dotted, \"name[]\" is a list whose items have the fields \"name[].x\"; an \"object\" field lists its own fields under its path; nullable fields may be null (an object then has no sub-fields); the routes are exactly the 5.4 rows whose read-health projection is viewer or whole",
 "types": {
  "count": "a non-negative integer",
  "days": "an integer (negative when past)",
  "enum": "one of the field's values",
  "version": "a string matching ^[0-9]+(\\.[0-9]+){1,3}$",
  "bool": "true or false",
  "date": "a time: an integer in seconds (form s) or milliseconds (form ms) as the AC-1 route gives it, or an ISO 8601 date YYYY-MM-DD (form iso)",
  "object": "an object holding only its listed sub-fields",
  "attention": "a list of attention items {kind, severity, args} from the allowlist below, args holding exactly that kind's fields"
 },
